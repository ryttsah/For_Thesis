.gcloudignore
.git
.github/
.vscode/
.cursor/
node_modules/
frontend/node_modules/
frontend/dist/
backend/.cnn-venv/
backend/.env
backend/pca_local.db
**/__pycache__/
**/*.pyc
tmp/
dataset_archive/

