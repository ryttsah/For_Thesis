# App
APP_NAME=PCA Negros Occidental API
DEBUG=false

# Comma-separated origins (local Vite + Vercel production URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# JWT — generate a strong secret for production
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Database — Supabase connection string or local SQLite
# Supabase: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./pca_local.db
DB_ECHO=false
AUTO_CREATE_DB=true
SEED_DEMO_DATA=false

# CNN — paths relative to project root (Thesis Website/)
ML_MODEL_PATH=Thesis AI Model/model_outputs/coconut_leaf_multilabel_cnn.keras
ML_LABEL_CONFIG_PATH=Thesis AI Model/model_outputs/label_config.json
